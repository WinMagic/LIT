<!DOCTYPE html>
@using System.Security.Claims
@using LIT.ServerMVC.Commons
@{
    var projectTitle = "WinMagic LIT Test server";
    var isAuthenticated = User.Identity?.IsAuthenticated == true;
}
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - @projectTitle</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/LIT.Server.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">
</head>
<body class="lit">
    <header class="lit-header">
        <div class="lit-container lit-header-inner">
            <a class="lit-brand" asp-area="" asp-controller="TodoItem" asp-action="Index">
                <svg width="28" height="28" viewBox="0 0 28 28" fill="none" aria-hidden="true">
                    <rect x="1" y="1" width="26" height="26" rx="6" stroke="currentColor" stroke-width="2"></rect>
                    <path d="M8 9v10h5M16 9v10M20 9h4M22 9v10" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path>
                </svg>
                <span class="lit-brand-name">lit.winmagic.dev</span>
                <span class="lit-brand-tag">LIT test server</span>
            </a>
            @if (isAuthenticated)
            {
                <div class="lit-identity">
                    <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                        <path d="M3 8.5l3 3 7-7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
                    </svg>
                    <span>
                        <strong>@User.Identity!.Name</strong> on
                        @User.FindFirstValue(Constants.DeviceNameClaim)
                    </span>
                </div>
            }
            else
            {
                <nav class="lit-nav">
                    <a href="@SiteLinks.Value.ChallengeUrl">The challenge</a>
                    <a href="@SiteLinks.Value.SourceUrl">Source on GitHub</a>
                </nav>
            }
        </div>
    </header>

    <main role="main" class="lit-container lit-main">
        @RenderBody()
    </main>

    <footer class="lit-footer">
        <div class="lit-container lit-footer-inner">
            <span>LIT (Live Identity in Transaction) is open source. It is the mechanism MagicEndpoint ships.</span>
            <span>WinMagic</span>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
