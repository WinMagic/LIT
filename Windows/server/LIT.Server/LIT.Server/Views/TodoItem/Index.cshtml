@model LIT.ServerMVC.Data.Models.TodoIndexViewModel

@{
    ViewData["Title"] = Model.IsAuthenticated ? "My Tasks" : "Welcome";
}


@if (!Model.IsAuthenticated)
{
    <section class="lit-hero">
        <div class="lit-hero-text">
            <h1>Welcome to the website of good cybersecurity!</h1>
            <p class="lit-tagline">There's no login and no logout.</p>
            <p class="lit-lead">Once you have registered and set up, this page will recognize you and your endpoint. 
                Your endpoint uses cryptography to represent the identity "user + device", because you have logged in to your endpoint.</p>
            <p class="lit-lead lit-strong">No one can use your page from another device.</p>
            @if (Model.CertificatePresented)
            {
                <p class="lit-notice">A key was presented, but it isn't registered to a user on this site.</p>
            }
            <div class="lit-cta">
                <a class="lit-btn" href="@SiteLinks.Value.AgentDownloadUrl">Try it: download the lightweight agent</a>
            </div>
        </div>
        <partial name="_ConnectionPanel" model="Model" />
    </section>

    <section class="lit-section">
        <h2>Other sites skip the login too. What's different?</h2>
        <div class="lit-cards">
            <div class="lit-card">
                <span class="lit-label">Most sites: they remember you</span>
                <p>Your browser keeps a cookie from the last login. Each visit, the site checks whether this still looks like you: same browser, usual place, usual habits.</p>
                <p class="lit-strong">A copy of that cookie, on someone else's computer, can look like you too.</p>
            </div>
            <div class="lit-card lit-card-accent">
                <span class="lit-label">This site: your device proves you</span>
                <p>On every connection, your device proves you with its own key. The key works only on your device, and only while you are logged in to it.</p>
                <p class="lit-strong">There is no authentication cookie to copy. Another computer has nothing to show.</p>
            </div>
        </div>
    </section>

    <section class="lit-section">
        <h2>How to get your own page</h2>
        <ol class="lit-steps">
            <li>
                <span class="lit-step-no">01</span>
                <strong>Install the agent</strong>
                <span class="lit-step-text">Lightweight, signed, with public hashes. <a href="@SiteLinks.Value.InstallStepsUrl">Installation steps</a></span>
            </li>
            <li>
                <span class="lit-step-no">02</span>
                <strong>Register once</strong>
                <span class="lit-step-text">Your device's key is registered with this site, for you on this device. <a href="@SiteLinks.Value.EnrollmentStepsUrl">Key creation and Certificate enrollment</a></span>
            </li>
            <li>
                <span class="lit-step-no">03</span>
                <strong>Come back</strong>
                <span class="lit-step-text">Open this address. Nothing to type</span>
            </li>
        </ol>
    </section>

    <section class="lit-faq">
        <div>
            <h2>Where is the login?</h2>
            <p>In the connection itself. Your device proves a key that stands for you, this device, 
                and its current conditions. The handshake is the login; the connections is the session. No authentication cookie, no token.</p>
        </div>
        <div>
            <h2>And the logout?</h2>
            <p>Close all browser windows. then reopen this page. Your device would have to prove you again by using your key(certificate).</p>
        </div>
        <div>
            <h2>Think you can get in anyway?</h2>
            <p>That is the challenge. Change another test user's task list without that user's key, through the connection to this server. Reports to <a href="mailto:@SiteLinks.Value.ReportEmail">@SiteLinks.Value.ReportEmail</a>.</p>
        </div>
    </section>
}
else
{
    <section class="lit-hero">
        <div class="lit-hero-text">
            <div>
                <h1>Welcome, @Model.UserName. Let's continue your work.</h1>
                <p class="lit-subtle">You typed nothing. Your device proved you when this page opened.</p>
                <div class="lit-tasks">
                    <div class="lit-tasks-head">
                        <h2>Your tasks</h2>
                        <div class="lit-tasks-meta">
                            <span>Synthetic test data</span>
                            <a class="lit-btn lit-btn-sm" asp-action="Create"><i class="bi bi-plus-lg me-1"></i>Add task</a>
                        </div>
                    </div>
                @if (!Model.Tasks.Any())
                {
                    <p class="lit-empty">No tasks yet. Add one to get started.</p>
                }

                @foreach (var item in Model.Tasks)
                {
                    <div class="lit-task @(item.IsCompleted ? "done" : "")">
                        <form asp-action="Toggle" asp-route-id="@item.Id" method="post">
                            <input type="checkbox" checked="@item.IsCompleted" onchange="this.form.submit()" aria-label="Completed: @item.Title" />
                            <noscript><button type="submit" class="btn btn-link btn-sm p-0 ms-2">Toggle</button></noscript>
                        </form>
                        <div class="lit-task-text">
                            <span class="lit-task-title">@item.Title</span>
                            @if (!string.IsNullOrEmpty(item.Description))
                            {
                                <span class="lit-task-desc">@item.Description</span>
                            }
                        </div>
                        <div class="lit-task-actions">
                            <a asp-action="Details" asp-route-id="@item.Id">Details</a>
                            <a asp-action="Edit" asp-route-id="@item.Id">Edit</a>
                            <a asp-action="Delete" asp-route-id="@item.Id">Delete</a>
                        </div>
                    </div>
                }
                </div>
            </div>
        </div>
        <partial name="_ConnectionPanel" model="Model" />
    </section>

    <section class="lit-faq">
        <div>
            <h2>Looking for logout?</h2>
            <p>Close all browser windows. then reopen this page. Your device would have to prove you again by using your key(certificate).</p>
        </div>
        <div>
            <h2>Try it from another computer</h2>
            <p>Open this address anywhere else, You get the welcome page or signed in as a different identity if that device also has a registered key, 
                because the key that proves you is on this device and nowhere else. </p>
        </div>
    </section>
}